# Микрофон и слайды Live-режима по дизайн-системе (docs/wiki/zapusk.md)
MODE=live
SLIDE_MODE=designer
APP_PORT=8088
DB_PASSWORD=local-development-only

# Инференс VK: все текстовые запросы к модели (колода, слайд из речи, правка голосом, проверка границ темы).
# Ключ и Project-ID выдают организаторы. Значения пишутся только в .env: он в .gitignore и .dockerignore.
# Код отправляет ключ и Project-ID только на этот адрес, адрес модели с экрана настроек их не получает.
VK_API_KEY=
VK_PROJECT_ID=
VK_INFERENCE_URL=https://ai-demo.platformpreview.ru/api/inference-providers-router/00000000-0000-0000-0000-000000000001/v1
LLM_URL=${VK_INFERENCE_URL}
LLM_MODEL=qwen38-27b-fp8
LLM_FALLBACK_MODEL=qwen38-27b-fp8
DESIGNER_LLM_URL=${VK_INFERENCE_URL}
DESIGNER_LLM_MODEL=qwen38-27b-fp8
DESIGNER_EDITOR_LLM_URL=${VK_INFERENCE_URL}
DESIGNER_EDITOR_LLM_MODEL=qwen38-27b-fp8
DESIGNER_EDITOR_LLM_PROTOCOL=openai
# Модель живого режима designer, если должна отличаться от основной
DESIGNER_LIVE_LLM_URL=
DESIGNER_LIVE_LLM_MODEL=

# Без ключа VK, локально в LM Studio: закомментируйте блок выше и раскомментируйте этот.
# LLM_URL=http://host.docker.internal:1234/v1
# LLM_MODEL=qwen/qwen3.8-27b
# LLM_FALLBACK_MODEL=qwen/qwen3.8-27b
# DESIGNER_LLM_URL=http://host.docker.internal:1234/v1
# DESIGNER_LLM_MODEL=qwen/qwen3.8-27b
# DESIGNER_EDITOR_LLM_URL=http://host.docker.internal:1234/v1
# DESIGNER_EDITOR_LLM_MODEL=qwen/qwen3.8-27b
# DESIGNER_EDITOR_LLM_PROTOCOL=openai
# Ключ другого OpenAI-совместимого API уходит только на DESIGNER_LLM_URL; LM Studio ключ не нужен
# DESIGNER_LLM_API_KEY=

# Картинки в слайдах: ComfyUI с FLUX.2 klein 4B на этой машине (scripts/start-images.ps1). Пусто: без картинок
DESIGNER_IMAGE_URL=http://host.docker.internal:8189

# Эмбеддинги для смысловых фрагментов речи: bge-m3 в LM Studio на этой машине (у VK эмбеддингов нет)
EMBEDDING_BACKEND=ollama
EMBEDDING_URL=http://host.docker.internal:1234/v1
EMBEDDING_MODEL=text-embedding-bge-m3
EMBEDDING_DIMENSION=1024
DESIGNER_DESIGN_SYSTEM_ID=
# Разрешённые адреса для CORS сервиса designer
DESIGNER_ALLOWED_ORIGINS=http://localhost:8088

# Адрес сервиса designer, каким его видит браузер (разрешается в политике безопасности страницы)
DESIGNER_PUBLIC_URL=http://localhost:8090
# Сколько запросов к модели идёт одновременно
DESIGNER_LLM_PARALLEL=4
